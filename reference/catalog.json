      "summary": "Read caller-owned temporal subjects in Timeline coordinates.",
      "authority": "Derived temporal projection.",
      "owns": ["projections", "sampling"],
      "doesNotOwn": ["canonical subject", "domain track semantics"],
      "workflow": ["Project", "Sample", "Read"],
      "symbolNames": [
        "projectTimelineSubject",
        "sampleTimelineTrack",
        "TimelineProjection",
        "TimelineTrackProjection"
      ]
    },
    {
      "id": "track-composition",
      "title": "Track composition",
      "summary": "Compose explicit, versioned track projectors supplied by specializations.",
      "authority": "Host-selected projection composition.",
      "owns": ["contribution contract", "deterministic composition"],
      "doesNotOwn": ["global registry", "source format", "domain vocabulary"],
      "workflow": ["Define", "Compose", "Project"],
      "symbolNames": [
        "defineTimelineTrackProjectionContribution",
        "TimelineTrackProjectionContribution",
        "TimelineProjectionDefinition"
      ]
