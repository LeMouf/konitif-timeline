      "workflow": ["Create", "Reduce", "Scale", "Project"],
      "symbolNames": [
        "createTimelineState",
        "createTimelineTicks",
        "getTimelineGridMetrics",
        "getTimelinePositionPercent",
        "getTimelineScrubResult",
        "getTimelineWheelZoomWindow",
        "reduceTimelineState",
        "normalizeTimelineViewWindow",
        "TimelineIntent",
        "TimelineState",
        "TimelineVisibleRange",
        "TimelineViewWindow"
      ]
    },
    {
      "id": "integration",
      "title": "Tool module",
      "summary": "Declare the Timeline contribution to a tool registry.",
      "authority": "Integration declaration.",
      "owns": ["Timeline capability"],
      "doesNotOwn": ["hosting"],
      "workflow": ["Declare", "Register", "Host"],
      "symbolNames": ["timelineToolModule"]
    }
  ]
}
